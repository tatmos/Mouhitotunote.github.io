<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/UIToolkit/GameStyles.uss?fileID=7433441134900000000&amp;guid=00000000000000000000000000000000&amp;type=3#GameStyles" />
    <ui:VisualElement name="TitleScreen" class="screen-background" style="flex-grow: 1;">
        <ui:VisualElement name="BackgroundImage" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
        <ui:VisualElement name="Content" class="card" style="flex-grow: 1; flex-direction: column; align-items: center; justify-content: center; padding: 32px; max-width: 1200px; margin: 20px auto;">
            <ui:Button name="StartButton" text="もうひとつを探す" class="button-gradient" style="min-width: 300px; min-height: 60px; font-size: 24px;" />
            <ui:VisualElement name="MysteryVoiceText" style="flex-direction: row; flex-wrap: wrap; justify-content: center; max-width: 800px; margin-top: 40px; display: none;" />
        </ui:VisualElement>
    </ui:VisualElement>

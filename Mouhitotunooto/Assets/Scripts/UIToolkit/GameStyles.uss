/* ゲーム全体のスタイル */

/* 画面全体の背景（ブラウン/セピア系） */
.screen-background {
    background-color: rgb(101, 67, 33); /* ブラウン/セピア系の背景 */
}

/* カードスタイル（背景は透明） */
.card {
    background-color: rgba(0, 0, 0, 0); /* 透明 */
    border-radius: 16px;
    padding: 40px;
    margin: 30px;
    /* box-shadowは削除（背景が透明なので不要） */
}

/* ダークモードのカード */
.card-dark {
    background-color: rgba(127, 29, 29, 0.9); /* red-900/90 */
    border-width: 2px;
    border-color: rgb(220, 38, 38); /* red-600 */
    border-radius: 16px;
    padding: 40px;
    margin: 30px;
}

/* プロフィールタブレイアウト */
.profile-tab-layout {
    display: flex;
    flex-direction: row;
    min-height: 500px;
    /* gapはUnity UI Toolkitでサポートされていないため、marginで代替 */
}

/* プロフィールリスト（左側） */
.profile-list-container {
    width: 250px;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0); /* 透明 */
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(184, 134, 11, 0.4); /* 金色系のボーダー（質感重視） */
}

/* プロフィール詳細（右側） */
.profile-detail-container {
    flex-grow: 1;
    min-width: 0;
    background-color: rgba(0, 0, 0, 0); /* 透明 */
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(184, 134, 11, 0.4); /* 金色系のボーダー（質感重視） */
    overflow: hidden;
}

/* プロフィールリストボタン */
.profile-list-button {
    width: 100%;
    min-height: 60px;
    padding: 12px;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0); /* 透明 */
    border-width: 2px;
    border-color: rgba(184, 134, 11, 0.4); /* 金色系のボーダー（質感重視） */
    -unity-text-align: upper-left;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(237, 215, 181); /* #EDD7B5 ベージュ系の色 */
    white-space: normal;
    transition-duration: 0.2s;
}

.profile-list-button:hover {
    background-color: rgba(218, 165, 32, 0.15); /* ホバー時は金色系の背景（質感重視） */
    border-color: rgba(184, 134, 11, 0.6); /* 金色系のボーダー */
}

.profile-list-button.active {
    background-color: rgba(218, 165, 32, 0.3); /* 金色系の背景（質感重視） */
    border-color: rgb(184, 134, 11); /* 金色のボーダー */
    color: rgb(237, 215, 181); /* ベージュ系のテキスト */
}

.profile-list-button.locked {
    background-color: rgba(200, 200, 200, 0.5);
    color: rgb(150, 150, 150);
    opacity: 0.6;
}

/* プロフィール詳細カード */
.profile-detail-card {
    padding: 20px;
    border-radius: 8px;
    border-width: 2px;
    min-height: 400px;
}

/* プロフィールカード */
.profile-card {
    width: 300px;
    min-height: 380px;
    padding: 15px;
    margin: 10px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.2);
}

/* プロフィールカードの色分け（暗めのブラウン/セピア/生成り/金系） */
.profile-card-momo {
    background-color: rgba(101, 67, 50, 0.85); /* 暗めのブラウン系（少しピンクがかった） */
    border-color: rgba(139, 90, 60, 0.7); /* 暗めのセピア系のボーダー */
}

.profile-card-umi {
    background-color: rgba(90, 70, 55, 0.85); /* 暗めのセピア系（少し青がかった） */
    border-color: rgba(120, 95, 75, 0.7); /* 暗めのセピア系のボーダー */
}

.profile-card-hiro {
    background-color: rgba(120, 90, 60, 0.85); /* 暗めの生成り/金色系 */
    border-color: rgba(160, 120, 80, 0.7); /* 暗めの金色系のボーダー */
}

.profile-card-toru {
    background-color: rgba(110, 85, 65, 0.85); /* 暗めの生成り系 */
    border-color: rgba(150, 115, 85, 0.7); /* 暗めの金色系のボーダー */
}

.profile-card-tsubasa {
    background-color: rgba(95, 75, 55, 0.85); /* 暗めのブラウン/セピア系（少し緑がかった） */
    border-color: rgba(125, 100, 75, 0.7); /* 暗めのセピア系のボーダー */
}

.profile-card-voice {
    background-color: rgba(100, 80, 60, 0.85); /* 暗めのセピア系 */
    border-color: rgba(130, 105, 80, 0.7); /* 暗めのセピア系のボーダー */
}

.profile-name {
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    color: rgb(237, 215, 181); /* #EDD7B5 ベージュ系の色 */
}

.profile-info {
    font-size: 14px;
    white-space: normal;
    margin-bottom: 10px;
    color: rgb(237, 215, 181); /* #EDD7B5 ベージュ系の色 */
}

.profile-quote {
    font-size: 12px;
    -unity-font-style: italic;
    margin-bottom: 10px;
    color: rgb(220, 200, 170); /* 少し薄いベージュ */
}

.profile-epilogue {
    font-size: 12px;
    white-space: normal;
    margin-top: 10px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(184, 134, 11, 0.4); /* 金色系のボーダー（質感重視） */
    color: rgb(237, 215, 181); /* #EDD7B5 ベージュ系の色 */
}

.profile-epilogue2 {
    font-size: 11px;
    white-space: normal;
    margin-top: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
    border-top-width: 1px;
    border-top-color: rgba(184, 134, 11, 0.3); /* 金色系のボーダー（質感重視） */
    background-color: rgba(80, 60, 45, 0.6); /* 暗めのブラウン/セピア系の背景（文字が見やすく） */
    color: rgb(237, 215, 181); /* #EDD7B5 ベージュ系の色 */
}

.profile-hint {
    font-size: 11px;
    white-space: normal;
    margin-top: 10px;
    padding: 10px;
    background-color: rgba(80, 60, 45, 0.7); /* 暗めのブラウン/セピア系の背景（文字が見やすく） */
    border-left-width: 4px;
    border-left-color: rgba(184, 134, 11, 0.6); /* 金色系のボーダー（質感重視） */
    color: rgb(237, 215, 181); /* #EDD7B5 ベージュ系の色 */
}

.profile-locked {
    font-size: 14px;
    -unity-font-style: italic;
    color: rgb(200, 180, 150); /* 少し薄いベージュ */
    -unity-text-align: middle-center;
}

/* ボタンのスタイル */
Button {
    min-height: 50px;
    padding: 10px;
    border-radius: 5px;
    background-color: rgb(100, 150, 255);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

Button:hover {
    background-color: rgb(80, 130, 235);
}

Button:active {
    background-color: rgb(60, 110, 215);
}

Button:disabled {
    background-color: rgb(150, 150, 150);
    color: rgb(200, 200, 200);
}

/* グラデーションボタン（生成り/木/金系） */
/* 注意：背景画像が設定されている場合は、コード側で背景色をColor.clearに設定しています */
.button-gradient {
    background-color: rgb(218, 165, 32); /* 金色系（フォールバック） */
    border-radius: 8px;
    transition-duration: 0.1s;
    transition-property: background-color;
    /* 背景画像はコード側で設定（9-slice対応） */
    /* box-shadowはUnity UI Toolkitでサポートされていないため削除 */
}

.button-gradient:hover {
    /* ホバー時の背景色変更は、画像が設定されている場合は無効化 */
    background-color: rgb(184, 134, 11); /* より濃い金色 */
    /* box-shadowはUnity UI Toolkitでサポートされていないため削除 */
}

.button-gradient-indigo {
    background-color: rgb(237, 215, 181); /* 生成り系（フォールバック） */
    border-radius: 8px;
    transition-duration: 0.1s;
    transition-property: background-color;
    /* 背景画像はコード側で設定（9-slice対応） */
    /* box-shadowはUnity UI Toolkitでサポートされていないため削除 */
}

.button-gradient-indigo:hover {
    /* ホバー時の背景色変更は、画像が設定されている場合は無効化 */
    background-color: rgb(218, 165, 32); /* 金色系 */
    /* box-shadowはUnity UI Toolkitでサポートされていないため削除 */
}

/* シナリオボタンのスタイル */
/* 注意：背景画像が設定されている場合は、コード側で背景色をColor.clearに設定しています */
/* 画像が設定されていない場合のフォールバックとして背景色を使用 */
.scenario-button-completed {
    background-color: rgb(34, 197, 94); /* green-500（フォールバック） */
    border-radius: 8px;
    /* 背景画像はコード側で設定（9-slice対応） */
}

.scenario-button-normal {
    background-color: rgb(218, 165, 32); /* 金色系（フォールバック） */
    border-radius: 8px;
    /* 背景画像はコード側で設定（9-slice対応） */
}

.scenario-button-normal:hover {
    /* ホバー時の背景色変更は、画像が設定されている場合は無効化 */
    /* 画像が設定されていない場合のみ有効 */
    background-color: rgb(184, 134, 11); /* より濃い金色 */
}

.scenario-button-locked {
    background-color: rgb(156, 163, 175); /* gray-400（フォールバック） */
    border-radius: 8px;
    opacity: 0.5;
}

/* シナリオボタンコンテナ（2行3列のグリッド） */
.scenario-grid-container {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    width: 100%;
    max-width: 960px;
    /* gapはUnity UI Toolkitでサポートされていないため、marginで代替 */
}

/* シナリオボタン（グリッド用の固定サイズ） */
.scenario-button {
    width: 300px;
    min-height: 180px;
    font-size: 20px;
    flex-shrink: 0;
    /* box-shadowはUnity UI Toolkitでサポートされていないため削除 */
}

.scenario-button:hover {
    /* box-shadowはUnity UI Toolkitでサポートされていないため削除 */
}

/* 選択肢ボタン */
/* 注意：背景画像が設定されている場合は、コード側で背景色をColor.clearに設定しています */
.choice-button {
    min-width: 780px;
    min-height: 120px;
    font-size: 20px;
    flex-direction: column;
    align-items: flex-start;
    background-color: rgb(218, 165, 32); /* 金色系（フォールバック） */
    border-radius: 8px;
    padding: 16px 24px;
    /* 背景画像はコード側で設定（9-slice対応） */
    /* box-shadowはUnity UI Toolkitでサポートされていないため削除 */
    transition-duration: 0.1s;
    transition-property: background-color;
}

.choice-button:hover {
    /* ホバー時の背景色変更は、画像が設定されている場合は無効化 */
    /* 画像が設定されていない場合のみ有効 */
    background-color: rgb(184, 134, 11); /* より濃い金色 */
    /* box-shadowはUnity UI Toolkitでサポートされていないため削除 */
}

/* ダークモードの選択肢ボタン */
.choice-button-dark {
    background-color: rgb(220, 38, 38); /* red-600（フォールバック） */
    border-width: 2px;
    border-color: rgb(248, 113, 113); /* red-400 */
    /* 背景画像はコード側で設定（9-slice対応） */
}

.choice-button-dark:hover {
    /* ホバー時の背景色変更は、画像が設定されている場合は無効化 */
    background-color: rgb(185, 28, 28); /* red-700 */
}

/* テキストスタイル */
.title-text {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(237, 215, 181); /* #EDD7B5 ベージュ系の色 */
    margin-bottom: 10px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8); /* 影を追加して読みやすく（濃い影） */
}

.title-text-dark {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(153, 27, 27); /* red-800 */
    margin-bottom: 10px;
}

.score-text {
    font-size: 24px;
    color: rgb(237, 215, 181); /* #EDD7B5 ベージュ系の色 */
    margin-bottom: 20px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8); /* 影を追加して読みやすく（濃い影） */
}

.score-text-anomaly {
    font-size: 24px;
    color: rgb(239, 68, 68); /* red-500 */
    -unity-font-style: bold;
}

/* 結果表示のスタイル */
.word-get-success {
    background-color: rgba(237, 215, 181, 0.9); /* 生成り系の背景（質感重視） */
    border-width: 2px;
    border-color: rgb(218, 165, 32); /* 金色系のボーダー（質感重視） */
    border-radius: 8px;
    padding: 16px;
    color: rgb(101, 67, 33); /* ブラウン系のテキスト */
    -unity-font-style: bold;
    font-size: 20px;
    -unity-text-align: middle-center;
}

.word-get-failed {
    background-color: rgba(139, 90, 43, 0.7); /* セピア系の背景（質感重視） */
    border-width: 2px;
    border-color: rgb(101, 67, 33); /* ブラウン系のボーダー（質感重視） */
    border-radius: 8px;
    padding: 16px;
    color: rgb(237, 215, 181); /* 生成り系のテキスト */
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.word-get-dark {
    background-color: rgb(127, 29, 29); /* red-900 */
    border-width: 2px;
    border-color: rgb(220, 38, 38); /* red-600 */
    border-radius: 8px;
    padding: 16px;
    color: rgb(254, 202, 202); /* red-200 */
    -unity-font-style: bold;
    font-size: 20px;
    -unity-text-align: middle-center;
}

/* 後日談のスタイル */
.epilogue-box {
    border-left-width: 4px;
    border-left-color: rgb(59, 130, 246); /* blue-500 */
    padding: 16px;
    background-color: rgb(239, 246, 255); /* blue-50 */
}

.epilogue-box-dark {
    border-left-width: 4px;
    border-left-color: rgb(220, 38, 38); /* red-600 */
    padding: 16px;
    background-color: rgb(127, 29, 29); /* red-900 */
}

.epilogue-title {
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    color: rgb(237, 215, 181); /* #EDD7B5 ベージュ系の色 */
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8); /* 影を追加して読みやすく（濃い影） */
}

.epilogue-title-dark {
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    color: rgb(254, 202, 202); /* red-200 */
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8); /* 影を追加して読みやすく（濃い影） */
}

.epilogue-text {
    white-space: normal;
    color: rgb(237, 215, 181); /* #EDD7B5 ベージュ系の色 */
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8); /* 影を追加して読みやすく（濃い影） */
}

.epilogue-text-dark {
    white-space: normal;
    color: rgb(254, 226, 226); /* red-100 */
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8); /* 影を追加して読みやすく（濃い影） */
}

/* 実績表示のスタイル */
.achievement-grid {
    /* gapはUnity UI Toolkitでサポートされていないため、marginで代替 */
}

.achievement-ends-container {
    /* gapはUnity UI Toolkitでサポートされていないため、marginで代替 */
}

.achievement-card {
    background-color: rgba(237, 215, 181, 0.85); /* 生成り系の背景（質感重視） */
    border-radius: 8px;
    padding: 16px;
    border-width: 2px;
    border-color: rgba(184, 134, 11, 0.5); /* 金色系のボーダー（質感重視） */
    margin: 8px;
}

.achievement-end-unlocked {
    background-color: rgba(237, 215, 181, 0.9); /* 生成り系の背景（質感重視） */
    border-width: 2px;
    border-color: rgb(218, 165, 32); /* 金色系のボーダー（質感重視） */
    border-radius: 6px;
    padding: 12px;
}

.achievement-end-unlocked-false {
    background-color: rgba(139, 90, 43, 0.7); /* セピア系の背景（質感重視） */
    border-width: 2px;
    border-color: rgb(101, 67, 33); /* ブラウン系のボーダー（質感重視） */
    border-radius: 6px;
    padding: 12px;
}

.achievement-end-dark {
    background-color: rgba(127, 29, 29, 1); /* red-900 */
    border-width: 2px;
    border-color: rgb(220, 38, 38); /* red-600 */
    border-radius: 6px;
    padding: 12px;
}

.achievement-end-locked {
    background-color: rgba(101, 67, 33, 0.3); /* ブラウン/セピア系の背景（質感重視） */
    border-width: 2px;
    border-color: rgba(139, 90, 43, 0.4); /* セピア系のボーダー（質感重視） */
    border-radius: 6px;
    padding: 12px;
    opacity: 0.6;
}

/* エンドクレジットのスタイル */
.credits-card {
    background-color: rgba(0, 0, 0, 0.8);
    color: rgb(255, 255, 255);
}

.credits-title {
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.credits-content-item {
    flex-direction: column;
    align-items: center;
    margin-bottom: 16px;
}

/* クリッカブルな「もうひとつ」のスタイル */
.clickable-word {
    border-bottom-width: 1px;
    border-bottom-color: rgba(0.2, 0.6, 1.0, 1.0);
    /* cursorはUnity UI Toolkitでサポートされていないため削除 */
}

/* カウントダウンコンテナ */
.countdown-container {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 8px;
    padding: 12px 16px;
    min-width: 80px;
}

/* スクロールバーのスタイル（ブラウン/セピア/金色系） */
/* ScrollView内のSlider要素にスタイルを適用 */
ScrollView Slider {
    /* スクロールバーのトラック（背景） */
}

ScrollView Slider > .unity-slider__track {
    background-color: rgba(101, 67, 33, 0.2); /* ブラウン系のトラック（薄め） */
    border-radius: 6px;
}

/* スクロールバーのフィル（使用済み部分） */
ScrollView Slider > .unity-slider__fill {
    background-color: rgba(184, 134, 11, 0.4); /* 金色系のフィル（半透明） */
    border-radius: 6px;
}

/* スクロールバーのサム（つまみ） */
ScrollView Slider > .unity-slider__thumb {
    background-color: rgba(218, 165, 32, 0.8); /* 金色系のサム（やや濃い） */
    border-width: 1px;
    border-color: rgba(184, 134, 11, 0.9); /* 金色系のボーダー */
    border-radius: 6px;
    transition-duration: 0.2s;
}

/* 縦スクロールバーのサム（幅を設定） */
ScrollView Slider.vertical > .unity-slider__thumb {
    width: 10px;
    min-width: 10px;
}

/* 横スクロールバーのサム（高さを設定） */
ScrollView Slider.horizontal > .unity-slider__thumb {
    height: 10px;
    min-height: 10px;
}

/* スクロールバーのサム（ホバー時） */
ScrollView Slider > .unity-slider__thumb:hover {
    background-color: rgba(237, 215, 181, 0.9); /* 生成り系のサム（ホバー時） */
    border-color: rgba(218, 165, 32, 1.0); /* 金色系のボーダー（ホバー時） */
}

/* スクロールバーのサム（ドラッグ時） */
ScrollView Slider > .unity-slider__thumb:active {
    background-color: rgba(184, 134, 11, 1.0); /* 金色系のサム（ドラッグ時） */
    border-color: rgba(218, 165, 32, 1.0); /* 金色系のボーダー（ドラッグ時） */
}

/* スクロールバーのスクローラー（コンテナ） */
ScrollView > .unity-scroll-view__vertical-scroller {
    width: 12px;
    background-color: rgba(101, 67, 33, 0.1); /* ブラウン系の背景（非常に薄め） */
    border-radius: 6px;
}

ScrollView > .unity-scroll-view__horizontal-scroller {
    height: 12px;
    background-color: rgba(101, 67, 33, 0.1); /* ブラウン系の背景（非常に薄め） */
    border-radius: 6px;
}


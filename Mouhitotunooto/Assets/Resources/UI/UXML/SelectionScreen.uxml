<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/UIToolkit/GameStyles.uss?fileID=7433441132597879392&amp;guid=129863cdc8fc8a64386b92878645c775&amp;type=3#GameStyles"/>
    <ui:VisualElement name="SelectionScreen" class="screen-background" style="flex-grow: 1; overflow: hidden;">
        <ui:VisualElement name="BackgroundImage" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;"/>
        <ui:ScrollView style="flex-grow: 1; overflow-y: hidden;">
            <ui:VisualElement name="Content" class="card" style="flex-direction: column; align-items: center; padding: 10px; max-width: 800px; margin: 10px auto;">
                <ui:Label name="TitleText" text="ミニノベルゲーム" style="font-size: 36px; -unity-font-style: bold; margin-bottom: 8px;"/>
                <ui:Label name="ScoreText" text="【もうひとつ】ワードゲット数: 0 / 6" style="font-size: 18px; margin-bottom: 10px;"/>
                <ui:VisualElement name="ScenarioButtonContainer" class="scenario-grid-container" style="flex-direction: row; flex-wrap: wrap; justify-content: center; width: 100%; max-width: 720px; gap: 10px; margin-bottom: 10px;"/>
                <ui:VisualElement name="MenuButtonContainer" style="flex-direction: row; justify-content: center; align-items: center; width: 100%; max-width: 800px; gap: 15px; flex-wrap: wrap;">
                <ui:Button name="ShowProfileButton" text="登場人物プロフィールを見る" class="button-gradient" style="min-width: 180px; min-height: 40px; flex: 1 1 180px; background-color: rgba(81, 81, 81, 0); background-image: url(&quot;project://database/Assets/Images/ChoiceBoard.png?fileID=21300000&amp;guid=4e4b90da8e4d4cb46a7196f79b2591e1&amp;type=3#ChoiceBoard&quot;); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                <ui:Button name="ShowCreditsButton" text="エンドクレジットを見る" class="button-gradient-indigo" style="min-width: 180px; min-height: 40px; display: none; flex: 1 1 180px;"/>
                <ui:Button name="ShowAchievementsButton" text="実績一覧を見る" class="button-gradient" style="min-width: 180px; min-height: 40px; display: none; flex: 1 1 180px; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                <ui:Button name="ShowMouhitotsuButton" text="物語の記録" class="button-gradient-indigo" style="min-width: 180px; min-height: 40px; display: none; flex: 1 1 180px; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:Button name="SoundButton" style="position: absolute; right: 20px; bottom: 20px; width: 48px; height: 48px; border-radius: 24px; font-size: 20px; padding: 0; background-color: rgba(0, 0, 0, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0;"/>
    </ui:VisualElement>
</ui:UXML>
